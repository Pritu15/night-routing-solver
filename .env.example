# Copy this file to .env and fill in your own Supabase project credentials.
# Only needed for live-DB runs (python run_ml_solver_db.py --date ...).
# Not needed at all for offline runs (python run_ml_solver_db.py --offline full_test_data.json ...).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
